#!/bin/sh

alias ..="cd ../"

alias ll='ls -GlA'
alias l='ls -Gl'

# Always open files in vertical split mode
alias vi='vim -O'
alias vimrc='vim $HOME/.vimrc'

alias find-inspect="ps aux | grep \"node --inspect-brk\" | grep -v grep"

export PATH="$PATH:/opt/homebrew/bin:$HOME/bin:$HOME/node_bin/node_modules/.bin:$HOME/.config/yarn/global/node_modules/.bin:$HOME/.local/bin:$HOME/.bun/bin"
export EDITOR="vim"
export JAVA_HOME="/usr/bin/java"
ENV_FILE=$HOME/.env

if [ -f "$ENV_FILE" ]; then

  # shellcheck source=./.env
  . "$ENV_FILE"
fi

export NVM_DIR="$HOME/.nvm"

nvm_file="$(brew --prefix nvm)/nvm.sh"

if [ -f "$nvm_file" ]; then
  # shellcheck source=/opt/homebrew/opt/nvm/nvm.sh
  . "$nvm_file"
else
  echo "Unable to source nvm.sh from $nvm_file"
fi

# Change directory to the repository root
cdr() {
  cd "$(git rev-parse --show-toplevel)" || return
}
export cdr
