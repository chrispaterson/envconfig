#!/bin/bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
home_dir=${HOME:?HOME must be set}
backup_dir=$home_dir/.envconfig-backups
[[ $# -eq 0 ]] || { printf 'Usage: %s\n' "$0" >&2; exit 2; }

# shellcheck source=lib/home-links.sh
source "$project_dir/lib/home-links.sh"
uninstall_home_links

# Resolve per-skill ownership without touching private or plugin-provided skills.
python3 - "$project_dir" "$home_dir" <<'PY'
from pathlib import Path
import sys

project, home = map(Path, sys.argv[1:])
source = project / 'agents' / 'skills'
for root in [home / '.agents' / 'skills', home / '.claude' / 'skills']:
    if root.is_symlink() or root.parent.is_symlink() or not root.is_dir():
        continue
    for entry in root.iterdir():
        if entry.is_symlink() and entry.resolve() == source / entry.name:
            entry.unlink()
PY
printf 'Removed links owned by this checkout and restored available home-file backups.\n'
printf 'Packages, private configuration, harness state, and skill-migration backups were retained.\n'
