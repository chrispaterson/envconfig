#!/bin/bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
home_dir=${HOME:?HOME must be set}
backup_dir=$home_dir/.envconfig-backups
cd "$project_dir"

case ${1:-} in
  --agent-skills-only)
    shift
    exec python3 "$project_dir/bin/install-agent-skills" "$@"
    ;;
  --links-only|'') ;;
  *) printf 'Usage: %s [--links-only | --agent-skills-only [options]]\n' "$0" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { printf 'Unexpected arguments\n' >&2; exit 2; }

# shellcheck source=lib/home-links.sh
source "$project_dir/lib/home-links.sh"

if [[ ${1:-} != --links-only ]]; then
  if ! git config --local --get core.hooksPath >/dev/null 2>&1 &&
     [[ ! -e $(git rev-parse --git-path hooks/pre-commit) ]]; then
    git config --local core.hooksPath .githooks
  fi
  git submodule update --init
  "$project_dir/humanize/install.sh" all
  make -C "$project_dir/.vim/pack/lib/start/vim-jsdoc" install
fi

install_home_links
python3 "$project_dir/bin/install-agent-skills"

if [[ ${1:-} == --links-only ]]; then
  printf 'Installed home and skill links.\n'
  exit 0
fi

if [[ ${OSTYPE:-} == darwin* ]]; then
  if ! command -v brew >/dev/null 2>&1; then
    export HOMEBREW_NO_INSTALL_FROM_API=1
    brew_installer=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)
    /bin/bash -c "$brew_installer"
    # Homebrew is not necessarily on PATH until a new shell starts.
    if [[ -x /opt/homebrew/bin/brew ]]; then
      export PATH="/opt/homebrew/bin:$PATH"
    elif [[ -x /usr/local/bin/brew ]]; then
      export PATH="/usr/local/bin:$PATH"
    fi
  fi
  while IFS= read -r tap || [[ -n $tap ]]; do
    [[ -z $tap || $tap == \#* ]] && continue
    brew tap "$tap"
  done < "$project_dir/brew_taps.txt"
  while IFS= read -r package || [[ -n $package ]]; do
    [[ -z $package || $package == \#* ]] && continue
    if ! brew list --versions "$package" >/dev/null 2>&1; then
      brew install "$package"
    fi
  done < "$project_dir/brew_apps.txt"
fi

"$project_dir/bin/yarn-global"
printf 'Installed. Source ~/.profile for the environment changes to take effect.\n'
