#!/bin/bash
source "${HOME}/bin/git-aliases/lib"

usage ()
{
  echo "Usage: git pr <command> [<pr-number>|<branch>]"
}

showhelp()
{
  echo "
  If no github pull request exists for this branch, a draft PR will be created
  and opened in the browser. Otherwise, just open the existing PR.

  Branch format: <username>/<JIRA-ISSUE>/<semantic-name>

  username      - is ignored

  JIRA-ISSUE    - When present, replaces 'Closes #' or 'Related #' in the PR
                  template body with the issue (e.g. Closes GRAPH-530). Also
                  used for Jira status transitions (ready, draft, merge, done).

  semantic-name - Converted from kebab-case to Title Case and used as the PR
                  title (e.g. add-plugin-validation -> Add Plugin Validation).

  CLI Dependencies: git, gh, node, jira (jira-cli).
  "
  echo " "
  usage
  echo " "
  echo "Commands:"
  echo "all                 Overview of all PRs for the repo related to me"
  echo "number              Prints PR number"
  echo "checks   [<pr>]     Displays pr automated checks status"
  echo "done     [<pr>]     Checks to see that PR is merged, deletes local branch, marks ticket Done"
  echo "draft    [<pr>]     Moves PR back to draft state and transitions Jira issue status to In Development"
  echo "help                Show brief help"
  echo "merge    [<pr>]     Merges the PR (--auto --squash) and transitions Jira issue status to Ready To Merge"
  echo "url      [<pr>]     Prints PR URL"
  echo "status   [<pr>]     Show PR status"
  echo "others              Show PRs I have reviewed that are not yet merged"
  echo "ready    [<pr>]     Moves PR from draft to ready state and transitions Jira issue status to In Review"
}

# Strip -y/--yes flag from args before positional parsing. Export GIT_ALIAS_YES
# so lib's confirm()/assume_yes() helpers pick it up.
filtered_args=()
for arg in "$@"; do
  if [[ "$arg" == "-y" || "$arg" == "--yes" ]]; then
    export GIT_ALIAS_YES=1
  else
    filtered_args+=("$arg")
  fi
done
set -- "${filtered_args[@]}"

command="$1"
branch_maybe="$2"

# Open a PR in the browser for a human, or just print its URL when there is no
# TTY (an agent can't see a browser tab, and opening one may block or fail).
open_or_print_pr() {
  if no_tty; then
    gh pr view "$@" --json url -q '.url'
  else
    gh pr view "$@" -w
  fi
}

# If called with just a number, view that PR in the browser
if [[ "$command" =~ ^[0-9]+$ && -z "$branch_maybe" ]]; then
  open_or_print_pr "$command"
  exit 0
fi



reviewed_by_me_prs () 
{
  bold=$(tput bold)
  echo ""
  echo "${bold}Reviewed but not yet merged${bold}"
  gh pr list -S "reviewed-by:@me -author:@me"
}

urlencode () {
  string=$1
  while [ -n "$string" ]; do
    tail=${string#?}
    head=${string%$tail}
    case $head in
      [-._~0-9A-Za-z]) printf %c "$head";;
      *) printf %%%02x "'$head"
    esac
    string=$tail
  done
  echo
}

branch=$(git branch --show-current)
pr_number=$(gh pr view --json number --jq '.number' 2>&1)
pr_state=$(gh pr view --json state --jq '.state' 2>/dev/null)
potential_issue=$(echo "$branch" | cut -d"/" -f2)
if [[ "$potential_issue" =~ ^[A-Za-z]+-[0-9]+$ ]]; then
  issue="$potential_issue"
fi


# If the second argument is a PR number, override for named commands that support it
if [[ "$2" =~ ^[0-9]+$ ]]; then
  case $command in
    checks|draft|merge|url|status|ready)
      pr_number="$2"
      branch=$(gh pr view "$pr_number" --json headRefName -q '.headRefName')
      potential_issue=$(echo "$branch" | cut -d"/" -f2)
      if [[ "$potential_issue" =~ ^[A-Za-z]+-[0-9]+$ ]]; then
        issue="$potential_issue"
      else
        issue=""
      fi
      ;;
  esac
fi

pr_ready() {
	gh pr ready "$pr_number"
	if [[ -n "$issue" ]]; then
		echo "Moving Jira issue $issue to In Review"
		jira issue move $issue "In Review"
		pr_url=$(gh pr view "$pr_number" --json url -q ".url")
		if [[ -n "$pr_url" ]]; then
			echo "Linking Jira issue $issue to PR $pr_url"
			jira issue link remote $issue "$pr_url" "GitHub Pull Request"
		else
			echo "Could not retrieve PR URL to add to Jira issue"
		fi

	fi
}

worktree_path_for_branch() {
  local branch_ref="refs/heads/$1"

  git worktree list --porcelain | awk -v ref="$branch_ref" '
    $1 == "worktree" { path = $2 }
    $1 == "branch" && $2 == ref { print path; exit }
  '
}

pr_done() {
    local _pr_number
    local _issue
    local _branch
    local _worktree
  if [[ $pr_state == "MERGED" ]]; then
    _pr_number="${1:-$pr_number}"
    _issue="${2:-$issue}"
    _branch="${3:-$branch}"
    _worktree=$(worktree_path_for_branch "$_branch")

    if [[ -z "$_worktree" ]]; then
      if [[ $_branch == "$(git branch --show-current)" ]]; then
        git checkout main
      fi
    else
      echo "Removing worktree $_worktree"
      cd "$(worktree_path_for_branch "main")" || echo "Unable to cd to main worktree"
      worktree_parent="$(dirname "$_worktree")"
      git worktree remove "$_worktree"
      if [ -z "$(ls -A "$worktree_parent")" ]; then
        rm -rf "$worktree_parent"
      fi 
    fi
    echo "Deleting branch $_branch"
    git branch -D "$_branch"
    jira issue move "$_issue" "Done"
  else
    echo "Unable to close PR, it is not merged"
    exit 1
  fi
}

case $command in
  help)
    showhelp
    exit
    ;;
  ready)
		pr_ready
    echo "PR $pr_number is ready for review!"

    exit
    ;;
  number)
    echo "$pr_number"
    exit
    ;;
	url)
		gh pr view "$pr_number" --json url -q ".url"
		exit
		;;
  done)
    pr_done "$2" "$3" "$4"
    exit
    ;;
  status)
    status=$(gh pr view "$pr_number" --json state -q '.state' 2>/dev/null)
    if [[ -n "$status" ]]; then
      echo "$status"
    else
      echo "Not found"
    fi
    exit
    ;;
  draft)
    gh pr ready "$pr_number" --undo
    if [[ -n "$issue" ]]; then
      echo "Moving Jira issue $issue to In Development"
    jira issue move "$issue" "In Development"
  fi
    echo "PR $pr_number moved back to draft."
    exit
    ;;
  checks)
    echo "Getting PR check status for $pr_number"
    gh pr checks "$pr_number"
    exit
    ;;
  merge)
    gh pr merge "$pr_number" --auto --squash
    _repo=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
    _repo_root=$(git rev-parse --show-toplevel)
    "${HOME}/bin/git-aliases/pr-watch" "$pr_number" "$_repo" "${issue:-}" "$branch" "$_repo_root"
    if [[ -n "$issue" ]]; then
      jira issue move "$issue" "Ready To Merge"
    fi
    # If this PR touches graph-sdk, review the Plugin Developer Guide for doc updates
    if gh pr diff "$pr_number" --name-only 2>/dev/null | grep -q "^packages/graph-sdk/src/"; then
      echo "📖 graph-sdk src/ changes detected — reviewing Plugin Developer Guide for doc updates..."

      add_to_epic_maybe=""
      if [[ -n "$issue" ]]; then
        add_to_epic_maybe=" Add it to the same Epic as $issue."
      fi
      _sdk_diff=$(gh pr diff "$pr_number" -- packages/graph-sdk/ 2>/dev/null | head -500)
      _sdk_prompt="The PR on branch $branch includes changes to packages/graph-sdk/. Review the Plugin Developer Guide at https://wiki.corp.adobe.com/pages/viewpage.action?pageId=3769393821 against the gh pr diff for PR number $pr_number and determine whether any documentation updates are needed. If so, create a Jira ticket in the GRAPH project describing exactly what needs to change and why. You're running in non-interactive mode, so don't ask for confirmations from the user.  Don't add it to the active sprint.$add_to_epic_maybe If no updates are needed, just say so briefly.

$_sdk_diff"
      _doc_review_log=$(mktemp /tmp/graph-sdk-doc-review.XXXXXX.log)
      echo "Running doc review in background — output: $_doc_review_log"
      claude --print "$_sdk_prompt" > "$_doc_review_log" 2>&1 &
      disown
    fi
      exit
      ;;
    all)
      gh pr status
      reviewed_by_me_prs
      exit
      ;;
    others)
      reviewed_by_me_prs
      exit
      ;;
    build)
		echo "This command is deprecated."
      exit
      ;;
    *)
      if [ -n "$command" ]; then
        showhelp
        exit 1
      fi
      ;;
esac

# No subcommand: open existing PR or create then open
if [[ "$pr_number" =~ ^[0-9]+$ && "$pr_state" == "OPEN" ]]; then
  open_or_print_pr
  exit 0
fi

# No PR or closed: create + open
if [[ $pr_number =~ ^no.*$ || "$pr_state" == "CLOSED" ]]; then
  to_branch="main" && [[ $# -gt 1 ]] && to_branch=$branch_maybe

  if [[ $to_branch == "$branch" ]]; then
    echo "Can't PR from $branch to $to_branch because they are the same"
    exit 1
  fi
  semantic_name="${branch##*/}"
  # Convert to title case
  semantic_name=$(node -e "console.log(\"$semantic_name\".split('-').map((word) => word.replace(/^[a-z]/, (lower) => lower.toUpperCase())).join(' '))")
  title="$semantic_name"

  if ! confirm "Create Pull Request: $title?"; then
    echo
    echo "It's cool, we all make mistakes..."
    echo
    exit
  fi
  echo "Creating Pull Request: $title"

  git fetch
  # actually create the PR
  echo "Creating Pull Request to $to_branch, with title: $title"

  gh pr create -B "$to_branch" -t "$title"  -d >/dev/null 2>&1
  if command -v claude >/dev/null 2>&1; then
    echo "Generating PR summary with AI ✨"
    run_with_spinner "Generating PR summary" claude --print "/pr-summary"
  fi
fi

open_or_print_pr
