#!/bin/bash
set -e

# Resolve issue number from arg, or infer from current branch
issue_number="$1"
if [[ -z "$issue_number" ]]; then
  branch=$(git branch --show-current)
  potential=$(echo "$branch" | cut -d"/" -f2)
  if [[ "$potential" =~ ^[A-Za-z]+-[0-9]+$ ]]; then
    issue_number="$potential"
  fi
fi

if [[ -z "$issue_number" ]]; then
  echo "Usage: git do <ISSUE-NUMBER>"
  echo "Or run from a branch named <user>/<ISSUE-NUMBER>/<slug>"
  exit 1
fi

worktree_path="$(git rev-parse --git-common-dir)/agent-worktrees/$issue_number"
plan_file="$worktree_path/plans/$issue_number.plan.md"

if [[ ! -d "$worktree_path" ]]; then
  echo "No worktree found for $issue_number at $worktree_path"
  echo "Run 'git start $issue_number' first to set up the branch and plan."
  exit 1
fi
if [[ ! -f "$plan_file" ]]; then
  echo "No PLAN.md found at $plan_file"
  echo "Run 'git start $issue_number' to generate the plan first."
  exit 1
fi

plan=$(cat "$plan_file")

cd "$worktree_path"
branch_name=$(git branch --show-current)

echo "Executing plan for $issue_number on branch $branch_name..."
echo

agent_prompt="You are implementing Jira issue $issue_number. Here is the approved plan:

---
$plan
---

Execute the plan above step by step:
1. Follow the Implementation Plan (or Fix Plan for bugs) in order
2. Use TDD: write failing tests first, then implement to make them pass
3. Run rushx build, rushx lint, rushx test in every package you touch — fix all failures before finishing
4. Do not open a PR — that is handled after you finish"

claude --permission-mode auto --model sonnet "$agent_prompt"

echo
echo "Implementation complete. Opening PR..."
"${HOME}/bin/git-aliases/pr" -y
