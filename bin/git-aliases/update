#!/bin/bash
from_branch="main"

cd "$(git rev-parse --show-toplevel)" || exit 1

# Find if from_branch is already checked out in a worktree
main_worktree=$(git worktree list --porcelain | awk -v branch="refs/heads/${from_branch}" '
  /^worktree /{wt=$2}
  $0 == "branch " branch {print wt}
')

if [[ -n "$main_worktree" ]]; then
  # Pull in whichever worktree has main checked out
  (cd "$main_worktree" && git pull --prune)
else
  # main not checked out anywhere — switch, pull, switch back
  git switch "$from_branch"
  git pull --prune
  git switch -
fi

git merge "$from_branch" --no-edit

if [[ -f rush.json ]]; then
  files=(
    "common/config/rush/pnpm-lock.yaml"
    "common/config/rush/repo-state.json" 
  )
  git checkout $from_branch -- "${files[@]}"

fi

conflicts=$(git diff --name-status --diff-filter=U)

# There are no conflicts
if [[ -z "$conflicts" ]]; then
  # Handle Rush repo
  if [[ -f ./rush.json ]]; then
    rush update
    git add -A
    git commit --amend --no-edit
  fi
else
  echo "Please resolve merge conflicts before committing"
fi
