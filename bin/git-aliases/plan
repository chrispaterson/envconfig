#!/bin/bash
set -e

source "${HOME}/bin/git-aliases/lib"

# Resolve issue number from arg or current branch
issue_number="$1"
if [[ -z "$issue_number" ]]; then
  branch=$(git branch --show-current)
  potential=$(echo "$branch" | cut -d"/" -f2)
  if [[ "$potential" =~ ^[A-Za-z]+-[0-9]+$ ]]; then
    issue_number="$potential"
  fi
fi

if [[ -z "$issue_number" ]]; then
  echo "Usage: git review-plan <ISSUE-NUMBER>"
  echo "Or run from a branch named <user>/<ISSUE-NUMBER>/<slug>"
  exit 1
fi

worktree_path="$(git rev-parse --git-common-dir)/agent-worktrees/$issue_number"
plan_file="$worktree_path/plans/$issue_number.plan.md"

if [[ ! -f "$plan_file" ]]; then
  echo "No plan found at $plan_file"
  echo "Run 'git start $issue_number' to generate a plan first."
  exit 1
fi

prompt="Let's review $plan_file together. Read the file and be ready to work interactively to refine it."

echo "Opening plan review... (type /desktop to continue in the desktop app)"
claude "$prompt"
