#!/bin/bash

set -e
base_branch="main"

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: git b [OPTIONS] [BASE_BRANCH] [ISSUE]"
      echo
      echo "Creates a branch prefixed with the username."
      echo
      echo "Arguments (by format):"
      echo "  BASE_BRANCH   '.' (current) or branch name (e.g. main, feature/foo)"
      echo "  ISSUE        JIRA key (ISSUE-123) or GitHub (#123, 123, owner/repo#123)"
      echo
      echo "Examples:"
      echo "  git b main ISSUE-123     branch from main with Jira issue ISSUE-123"
      echo "  git b . 123              branch from current branch with GitHub issue 123"
      echo
      echo "Branch name format:"
      echo "  With issue:    {username}/{issue-id}/{semantic-name}"
      echo "  Without issue: {username}/{semantic-name}"
      echo
      echo "  e.g. username/ISSUE-123/add-plugin-validation"
      echo "  e.g. username/123/fix-button-styling"
      echo "  e.g. username/my-feature"
      exit 0
      ;;
    -*)
      # future options could go here
      args+=("$1")
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

# Classify positional args: base branch vs issue
# Base branch: "." (current) or contains "/" or doesn't match issue pattern
# Jira issue: PROJECT-123 (e.g. ISSUE-123)
# GitHub issue: 123, #123, or owner/repo#123
issue_type=""
for arg in "${args[@]}"; do
  if [[ "$arg" == "." ]]; then
    base_branch="$arg"
  elif [[ "$arg" =~ ^[a-zA-Z]+-[0-9]+$ ]]; then
    if [[ -z "$issue_number" ]]; then
      issue_number="$arg"
      issue_type="jira"
    fi
  elif [[ "$arg" =~ ^#?[0-9]+$ ]] || [[ "$arg" =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+#[0-9]+$ ]]; then
    if [[ -z "$issue_number" ]]; then
      issue_number="$arg"
      issue_type="github"
    fi
  else
    base_branch="$arg"
  fi
done

if [[ "$base_branch" == "." ]]; then
  base_branch=$(git branch --show-current)
fi

if [[ -z "$issue_number" ]]; then
  echo "Issue number?"
  read -r issue_number
fi

source "$HOME/.env"
source "${HOME}/bin/git-aliases/lib"

jira_issue_info=$(jira issue view "$issue_number" --raw 2>/dev/null)
jira_issue_view=$(jira issue view "$issue_number" 2>/dev/null)
summary=$(echo "$jira_issue_info" | jq -r '.fields.summary // empty')
jira_issue_type=$(echo "$jira_issue_info" | jq -r '.fields.issuetype.name // empty')

git fetch --prune

# Worktrees live under .git/agent-worktrees/ — never appear in git status.
# Plan file lives inside the worktree at plans/<issue>.plan.md so it shows up
# in editor file panels; gitignored locally via .git/info/exclude (see below).
worktree_path="$(git rev-parse --git-common-dir)/agent-worktrees/$issue_number"
plan_file="$worktree_path/plans/$issue_number.plan.md"

created_worktree="false"

# Check for an existing worktree before generating a branch name
if [[ -d "$worktree_path" ]]; then
  echo "Found existing worktree for $issue_number, reusing..."
  branch_name=$(git -C "$worktree_path" branch --show-current)
else
  # Search for any local branch containing this issue number (semantic name may differ)
  existing_branch=$(git branch --list "*/$issue_number/*" | sed 's/^[* ]*//' | head -1)

  if [[ -n "$existing_branch" ]]; then
    echo "Found existing branch $existing_branch for $issue_number, adding worktree..."
    branch_name="$existing_branch"
    git worktree add "$worktree_path" "$branch_name"
    created_worktree="true"
  else
    # No existing branch — generate a name and create
    if [[ -n "$summary" ]]; then
      if command -v claude >/dev/null 2>&1; then
        branch_semantic_name=$(run_with_spinner "Generating branch name" claude --print "Generate a short git branch name (lowercase, hyphens, no spaces, max 4-5 words) for this issue: $summary. Output ONLY the branch name, nothing else." | tail -1 | tr -d '\n' | xargs) || branch_semantic_name=""
      else
        echo "Warning: 'claude' command not found. Skipping AI branch name generation ❌"
        branch_semantic_name=""
      fi
    fi

    if [[ -z "$branch_semantic_name" ]]; then
      echo
      echo "human-readable name?"
      read -r hr_name
      branch_semantic_name=${hr_name//[ ]/-}
    fi

    username="$(whoami)"
    branch_name="$username/$issue_number/$branch_semantic_name"

    read -p "Create branch $branch_name from $base_branch? [Y/n] " -n 1 -r
    echo
    if ! [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]; then
      echo "It's cool, we all make mistakes..."
      exit
    fi

    git worktree add -b "$branch_name" "$worktree_path" "origin/$base_branch"
    created_worktree="true"
  fi
fi

cd "$worktree_path"

# Ensure plans/ directory exists and is locally gitignored. .git/info/exclude
# is shared across worktrees in this repo and is never committed, so adding
# the entry here is safe and idempotent.
mkdir -p "$worktree_path/plans"
exclude_file="$(git rev-parse --git-common-dir)/info/exclude"
if ! grep -qxF "plans/" "$exclude_file" 2>/dev/null; then
  printf '\n# Local-only: per-ticket plan files (never committed)\nplans/\n' >> "$exclude_file"
fi

if [[ "$created_worktree" == "true" ]]; then
  git push --set-upstream origin "$branch_name"
  if [ -f "./rush.json" ]; then
    rush update
    rush build
  fi
fi

echo
echo "Branch: $branch_name"
echo "Worktree: $worktree_path"

read -p "Launch Planning Agent? [Y/n] " -n 1 -r
echo    # move to a new line

if ! [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]
then
  echo "Ok, cool...  Good luck, human"
  exit 

fi

echo "Launching planning agent for $issue_number (${jira_issue_type:-unknown type})..."
echo

if [[ "$(echo "$jira_issue_type" | tr "[:upper:]" "[:lower:]")" == "bug" ]]; then
  agent_prompt="You are analyzing Jira bug $issue_number to identify the root cause and produce a fix plan.

Here is the full issue:
---
$jira_issue_view
---

IMPORTANT: Do NOT write any code or modify any source files. Your only output is the plan file.

Steps:
1. Explore the codebase — trace the relevant code paths to pinpoint the specific
   file(s), line(s), and reason the bug occurs.
2. Write $plan_file with these sections:
     # $issue_number — Bug
     ## Summary
     (bug description and steps to reproduce)
     ## Root Cause
     (specific files + line numbers, and a clear explanation of why the bug occurs)
     ## Fix Plan
     (ordered steps: what to change, where, and why)
     ## Test Plan
     (unit tests, integration tests, and manual steps to verify the fix)
3. Print the path to the plan file and stop. Do not implement anything."
else
  agent_prompt="You are analyzing Jira story $issue_number to produce an implementation plan.

Here is the full issue:
---
$jira_issue_view
---

IMPORTANT: Do NOT write any code or modify any source files. Your only output is the plan file.

Steps:
1. Explore the codebase to identify the relevant packages, files, and touch points.
2. Write $plan_file with these sections:
     # $issue_number — Story
     ## Summary
     (issue summary and acceptance criteria)
     ## Relevant Code
     (key files and packages, with a brief note on why each is relevant)
     ## Implementation Plan
     (ordered steps to implement the story — specific enough to act on)
     ## Test Plan
     (unit tests, integration tests, and manual verification steps)
3. Print the path to the plan file and stop. Do not implement anything."
fi

run_with_spinner "Planning $issue_number" claude --permission-mode auto --model opus --print "$agent_prompt"
